{
  "name": "bpa-backend-api",
  "version": "1.0.0",
  "description": "Bangladesh Pet Association — Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node -r dotenv/config ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "worker:dev": "node -r dotenv/config ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/worker.ts",
    "worker:start": "node -r dotenv/config dist/worker.js",
    "media:reconcile": "node -r dotenv/config ./node_modules/ts-node/dist/bin.js --transpile-only src/scripts/reconcileMediaStorage.ts",
    "clinics:import": "node -r dotenv/config ./node_modules/ts-node/dist/bin.js --transpile-only src/scripts/importClinicDirectory.ts",
    "build": "node -r dotenv/config ./node_modules/typescript/bin/tsc",
    "start": "node -r dotenv/config dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node -r dotenv/config prisma/seed/index.ts",
    "db:setup": "prisma migrate deploy && prisma generate && npm run db:seed",
    "clinic:seed:export": "ts-node -r dotenv/config scripts/export-clinic-seed.ts",
    "clinic:seed:validate": "ts-node -r dotenv/config scripts/validate-clinic-seed.ts",
    "clinic:seed": "ts-node -r dotenv/config prisma/seed/clinic-directory.seed.ts",
    "seed:video-categories": "ts-node -r dotenv/config prisma/seed-video-categories.ts",
    "seed:video-content": "ts-node -r dotenv/config prisma/seed-video-content.ts",
    "seed:homepage-content": "ts-node -r dotenv/config prisma/seed-homepage-content.ts",
    "verify:video-categories": "ts-node -r dotenv/config scripts/verify-video-category-api.ts",
    "seed:verify": "jest --runInBand prisma/__tests__/video-categories.seed.test.ts prisma/__tests__/video-content.seed.test.ts prisma/__tests__/clinic-directory.seed.test.ts prisma/__tests__/master-seed.contract.test.ts src/modules/content/__tests__/public-video-categories.service.test.ts",
    "seed:legacy": "ts-node -r dotenv/config prisma/seed.ts",
    "seed:root-admin": "ts-node -r dotenv/config prisma/seed-root-admin.ts",
    "reset:local-admin": "ts-node -r dotenv/config prisma/reset-local-admin.ts",
    "seed:hero": "ts-node -r dotenv/config prisma/seed-hero.ts",
    "seed:donations": "ts-node -r dotenv/config prisma/seed-donations.ts",
    "seed:locations": "ts-node -r dotenv/config scripts/location-data/seed-locations.ts",
    "seed:coverage-backfill": "ts-node -r dotenv/config prisma/seed-coverage-areas-backfill.ts",
    "db:studio": "prisma studio",
    "storage:test": "ts-node -r dotenv/config scripts/test_storage.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/lib-storage": "^3.1068.0",
    "@prisma/client": "^5.14.0",
    "@smithy/node-http-handler": "^4.8.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.11",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "eps-gateway-nodejs": "^1.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.1.0",
    "imapflow": "^1.4.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.10",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.1",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "ts-node -r dotenv/config prisma/seed/index.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}

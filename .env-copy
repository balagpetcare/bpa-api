# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FURTAIL_API_BASE_URL=http://localhost:7200/api/v1
FURTAIL_API_TIMEOUT_MS=15000
FURTAIL_API_RETRY_LIMIT=1
# BPA forwards the caller's verified Central Auth bearer token to Furtail.
# No separate Furtail service credential is currently required for /me/pets.
# CENTRAL_AUTH_JWT_AUDIENCE must match the audience wpa_auth_api actually issues
# for the BPA mobile client ("bpa-mobile" — see wpa_auth_api prisma/seed.ts, the
# "World Pet Association" client falls back to the global default audience).
# Using "bpa-admin" here (the admin-panel audience) rejects every real user
# token and was the root cause of BPA My Pets showing "session expired".
CENTRAL_AUTH_JWT_SECRET="change-me-very-secret-access-token-key-12345"
CENTRAL_AUTH_JWT_PUBLIC_KEY=
CENTRAL_AUTH_JWT_ISSUER=http://localhost:5010
CENTRAL_AUTH_JWT_AUDIENCE=bpa-mobile
# bpa_admin's OAuth client is registered separately from the mobile client and
# Central Auth stamps its tokens with the "bpa-admin" audience — without this,
# every admin-panel login 401s on all /api/v1/admin/* and /api/v1/volunteers
# calls even though the token itself is valid (same root cause class as the
# "My Pets shows session expired" incident above, just for the admin client).
CENTRAL_AUTH_ADDITIONAL_JWT_AUDIENCES=bpa-admin
CENTRAL_AUTH_JWT_ALGORITHM=HS256

# ─── Seed Admin (used by: npm run db:seed) ───────────────────────
# These are used by the new unified seeder (prisma/seed/index.ts).
# Fallback: ROOT_ADMIN_* vars below are also supported for backward compat.
SEED_ADMIN_NAME="BPA Super Admin"
SEED_ADMIN_EMAIL=admin@bpa.org
SEED_ADMIN_PASSWORD=ChangeThisStrongPassword123!
SEED_ADMIN_ROLE=super_admin

# ─── Root Admin (used by: npm run seed:root-admin) ──────────────
ROOT_ADMIN_NAME="BPA Root Admin"
ROOT_ADMIN_EMAIL=admin@bpa.org
ROOT_ADMIN_PASSWORD=ChangeThisStrongPassword123!
ROOT_ADMIN_ROLE=super_admin

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://bpa_user:bpa_password123@127.0.0.1:5433/bpa_db?schema=public

# ─── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ──────────────────────────────────────────────
PUBLIC_REGISTRATION_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_REGISTRATION_RATE_LIMIT_MAX=50

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Bcrypt ─────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Email Gateway ──────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@example.com
EMAIL_PASS=email_password
EMAIL_FROM="Bangladesh Pet Association <no-reply@example.com>"

# ─── SMS Gateway ────────────────────────────────────────────────
SMS_API_URL=https://sms-gateway.example.com/api/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=BPA

# ─── EPS Payment Gateway ────────────────────────────────────────
# Set EPS_ENABLED=true and PAYMENT_CHANNEL_MODE=EPS to activate online payments.
# Leave EPS_ENABLED=false to use manual/support fallback mode (default for new installs).
#
# EPS_ENV=demo        → sandbox endpoints  (sandbox-pgapi.eps.com.bd) — for testing
# EPS_ENV=production  → live endpoints     (pgapi.eps.com.bd)         — for go-live
#
EPS_ENABLED=false
EPS_ENV=demo
PAYMENT_CHANNEL_MODE=MANUAL
EPS_MOCK_MODE=false
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=

# Comma-separated list of EPS callback server IPs to allowlist (production only).
# Leave empty in development — all IPs are accepted when the list is blank.
EPS_CALLBACK_IPS=

# ─── Media / File Storage ────────────────────────────────────────
# STORAGE_DRIVER=local  → write files to ./uploads/ (default for development)
# STORAGE_DRIVER=s3     → upload to S3-compatible provider (MinIO, AWS, DO Spaces, etc.)
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3
# MinIO (local dev):
#   S3_ENDPOINT=http://127.0.0.1:9000
#   S3_FORCE_PATH_STYLE=true
# AWS S3 (production):
#   S3_ENDPOINT=   (leave blank — SDK auto-resolves)
#   S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=bpa-media
S3_ACCESS_KEY_ID=your_minio_access_key
S3_SECRET_ACCESS_KEY=your_minio_secret_key
S3_FORCE_PATH_STYLE=true

# Public base URL used when building media URLs returned to clients.
# MinIO (local):  http://127.0.0.1:9000/bpa-media
# AWS S3:         https://bpa-media.s3.amazonaws.com
# DO Spaces:      https://bpa-media.nyc3.digitaloceanspaces.com
# Leave unset when STORAGE_DRIVER=local — falls back to BACKEND_URL/uploads
# (this was left pointing at a MinIO endpoint from an earlier S3 experiment;
# with STORAGE_DRIVER=local that made every upload URL point at a MinIO
# server that isn't running here, even though the file itself was written
# correctly to ./uploads/ — a broken "public URL" that never matched the
# actually-configured local storage backend.)
# MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/bpa-media

# ─── Video Upload Configuration ──────────────────────────────────
# Maximum video file size in MB
CONTENT_VIDEO_MAX_SIZE_MB=200

# Comma-separated list of allowed MIME types for video uploads
CONTENT_VIDEO_ALLOWED_MIME_TYPES=video/mp4,video/webm,video/quicktime,video/x-m4v

# ─── Auth & Social ──────────────────────────────────────────────
AUTH_COOKIE_NAME=bpa_user_session
AUTH_JWT_SECRET=replace_with_min_32_chars_secret
AUTH_JWT_EXPIRES_IN=7d
AUTH_PUBLIC_WEB_URL=https://bangladeshpetassociation.com
AUTH_ADMIN_WEB_URL=https://admin.bangladeshpetassociation.com
AUTH_API_URL=https://api.bangladeshpetassociation.com

# OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.bangladeshpetassociation.com/api/v1/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://api.bangladeshpetassociation.com/api/v1/auth/oauth/facebook/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=https://api.bangladeshpetassociation.com/api/v1/auth/oauth/instagram/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=https://api.bangladeshpetassociation.com/api/v1/auth/oauth/twitter/callback

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─── Mailing System (cPanel / Custom defaults) ───────────────────
MAIL_CREDENTIAL_SECRET=change_me_to_minimum_32_chars_secret
DEFAULT_SMTP_HOST=d552.dimedns.com
DEFAULT_SMTP_PORT=465
DEFAULT_SMTP_SECURE=true
DEFAULT_IMAP_HOST=d552.dimedns.com
DEFAULT_IMAP_PORT=993
DEFAULT_IMAP_SECURE=true
MAIL_SYNC_ENABLED=true
MAIL_SYNC_INTERVAL_MINUTES=5
MAIL_ATTACHMENT_MAX_MB=15

REDIS_URL=redis://127.0.0.1:6379
